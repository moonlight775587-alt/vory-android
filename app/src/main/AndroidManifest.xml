<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network for the gateway (LAN / tunnel / public). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Local approval / card notifications while backgrounded. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Attachments: photos + files. -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <uses-permission android:name="android.permission.READ_MEDIA_VISUAL_USER_SELECTED" />

    <application
        android:name=".VoryApp"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Vory"
        android:usesCleartextTraffic="true"
        tools:targetApi="36">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Vory">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Deep links: vory://chat/<sessionId> from notifications. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vory" android:host="chat" />
            </intent-filter>
            <!-- OIDC browser sign-in callback. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="vory" android:host="oauth" />
            </intent-filter>
        </activity>

        <!-- Notification action receiver (Approve once / Deny / Reply). -->
        <receiver
            android:name=".notifications.VoryActionReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="dev.vory.android.ACTION_APPROVAL" />
                <action android:name="dev.vory.android.ACTION_REPLY" />
            </intent-filter>
        </receiver>

        <!-- Open downloaded gateway files. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/filepaths" />
        </provider>

    </application>
</manifest>
